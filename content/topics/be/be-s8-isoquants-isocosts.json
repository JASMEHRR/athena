    {
      "id": "be-s8-isoquants-isocosts-c1",
      "heading": "Isoquants and the MRTS",
      "explanation_md": "An **isoquant** shows the long-run combinations of inputs (K, L) that give the **same level of output**. Its shape tells you how easily the producer can swap one input for the other while keeping output the same.\n\nThe **marginal rate of technical substitution (MRTS)** is the rate at which two inputs are substituted while keeping output the same: **MRTS_KL = MPL / MPK**.",
      "example_ids": [],
      "key_terms": [
        {
          "term": "Isoquant",
          "meaning": "Combinations of K and L that give the same output",
          "source_ref": "be--session-8#14"
        },
        {
          "term": "MRTS",
          "meaning": "The rate at which two inputs are substituted while keeping the same output; MRTS_KL = MPL/MPK",
          "source_ref": "be--session-8#15"
        }
      ],
      "exam_line": "Isoquant: same output, different input mixes. MRTS_KL = MPL/MPK.",
      "clarification": null,
