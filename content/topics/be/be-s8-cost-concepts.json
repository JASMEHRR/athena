    {
      "id": "be-s8-cost-concepts-c2",
      "heading": "Total, variable, fixed and sunk costs",
      "explanation_md": "**C(Q) = VC(Q) + FC**: the minimum total cost of producing each level of output.\n\n- **Variable cost VC(Q)** changes with output.\n- **Fixed cost FC** does not change as output changes.\n- **Sunk cost** is a cost that is **forever lost** once it has been paid. Decision makers should **ignore sunk costs** to maximise profit or minimise losses, because nothing they decide now can bring that money back.",
      "example_ids": [],
      "key_terms": [
        {
          "term": "Sunk cost",
          "meaning": "A cost that is forever lost after it has been paid",
          "source_ref": "be--session-8#25"
        },
        {
          "term": "Fixed cost",
          "meaning": "A cost that does not vary with output",
          "source_ref": "be--session-8#24"
        }
      ],
      "exam_line": "C(Q) = VC(Q) + FC. Ignore sunk costs when deciding.",
      "clarification": null,
      "check_questions": [
