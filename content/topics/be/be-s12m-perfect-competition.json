      "big_idea": "With price $10 and MC = 2Q, the firm produces 5 units and makes $20.",
      "analogy": null,
      "visuals": [],
      "worked": {
        "question_md": "Given P = $10 and C(Q) = 5 + Q². Find the optimal price, output and maximum profit.",
        "steps": [
          {
            "title": "Price",
            "body_md": "The firm is a price taker, so it charges the market price: **P = $10**.",
            "why": "A price taker cannot pick its own price.",
            "result": "P = $10"
          },
          {
            "title": "Marginal cost",
            "body_md": "C(Q) = 5 + Q², so **MC = 2Q\\** (differentiate: the 5 disappears, Q² becomes 2Q).",
            "why": "MC is the slope of the cost function.",
            "result": "MC = 2Q"
          },
          {
            "title": "Set P = MC",
            "body_md": "10 = 2Q, so **Q = 5 units\\**.",
            "why": "For a price taker, MR = P, so MR = MC means P = MC.",
            "result": "Q = 5"
          },
          {
            "title": "Profit",
            "body_md": "| Item | Working | Value |\n|---|---|---|\n| Revenue | 10 x 5 | 50 |\n| Cost | 5 + 5² = 5 + 25 | 30 |\n| Profit | 50 - 30 | **20** |",
            "why": "Profit is total revenue minus total cost.",
            "result": "Profit = $20"
          }
        ],
        "answer_md": "P = $10, Q = 5 units, maximum profit = **$20**."
      },
      "watch_out": [
        "Do not forget the **fixed cost of 5** when you work out total cost.",
        "Square Q before adding: C(5) = 5 + 25, not 5 + 10."
      ],
      "memory_trick": "",
      "exam_answer_md": "P = $10 (price taker). MC = 2Q. Set P = MC: 10 = 2Q, so **Q = 5**. Profit = PQ - C(Q) = (10)(5) - (5 + 25) = **$20**."
    }
