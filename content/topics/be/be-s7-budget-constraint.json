    {
      "id": "be-s7-budget-constraint-q-8d5250ff",
      "type": "short",
      "stem": "Explain, with a diagram description, what happens to the budget line when income rises and when the price of X falls.",
      "options": [],
      "answer": "",
      "accept": [],
      "explanation": "",
      "model_answer_md": "**Income rises (M1 > M0):** the budget line shifts **outward in parallel**; both intercepts grow and the slope Px/Py is unchanged.\n\n**Price of X falls:** the budget line **rotates counter-clockwise**; the Y intercept M0/Py stays the same and the X intercept moves out from M0/Px0 to M0/Px1.\n\nIn short, income changes shift the line, price changes rotate it.",
      "rubric": [
        {
          "point": "Income increase: parallel outward shift",
          "source_ref": "be--session-7#11"
        },
        {
          "point": "Price decrease: counter-clockwise rotation",
          "source_ref": "be--session-7#11"
        },
        {
          "point": "Income down: parallel downward; price up: clockwise",
          "source_ref": "be--session-7#11"
        }
      ],
      "marks": 3.0,
      "difficulty": 2,
      "style_tag": "explain",
      "source_refs": [
        "be--session-7#11"
      ],
      "derived": [],
      "needs_check": false,
      "retired": false
    },
    {
      "id": "be-s7-budget-constraint-q-0ba587a0",
      "type": "short",
      "stem": "Differentiate between the effect of a change in income and a change in the price of X on the budget line.",
      "options": [],
      "answer": "",
      "accept": [],
      "explanation": "",
      "model_answer_md": "| Point | Change in income | Change in price of X |\n|---|---|---|\n| Movement | Parallel shift | Rotation |\n| Increase | Outward | Price up: clockwise |\n| Decrease | Downward | Price down: counter-clockwise |\n| Slope | Unchanged (Px/Py) | Changes |",
      "rubric": [
        {
          "point": "Income: parallel shift outward or downward",
          "source_ref": "be--session-7#11"
        },
        {
          "point": "Price: rotation, clockwise or counter-clockwise",
          "source_ref": "be--session-7#11"
        },
        {
          "point": "Slope Px/Py changes only with price",
          "source_ref": "be--session-7#10"
        }
      ],
      "marks": 3.0,
      "difficulty": 2,
