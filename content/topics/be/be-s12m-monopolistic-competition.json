    {
      "id": "be-s12m-monopolistic-competition-c4",
      "heading": "Optimal advertising",
      "explanation_md": "Advertising helps firms with market power **differentiate** their products.\n\n- Advertise until the **additional revenue from advertising equals its additional cost**.\n- Equivalently, the **advertising-to-sales ratio** equals the **advertising elasticity of demand** divided by minus the **own-price elasticity**: **A/R = EQ,A / (-EQ,P)**.",
      "example_ids": [],
      "key_terms": [],
      "exam_line": "A/R = EQ,A / (-EQ,P).",
      "clarification": null,
      "check_questions": [
        {
          "id": "be-s12m-monopolistic-competition-q-3e11a0c3",
          "type": "mcq",
          "stem": "The profit-maximizing advertising-to-sales ratio equals:",
          "options": [
            "Advertising elasticity over minus own-price elasticity",
            "Own-price elasticity over advertising elasticity",
            "Price over marginal cost"
          ],
          "answer": "Advertising elasticity over minus own-price elasticity",
