    {
      "id": "be-s10-procuring-inputs-c4",
      "heading": "Transaction costs",
      "explanation_md": "**Transaction costs** are the costs of acquiring an input **over and above the amount paid to the input supplier**. They include:\n\n- **Search costs**\n- **Negotiation costs**\n- **Other required investments or expenditures**\n\nSome transactions are **general** in nature, while others are **specific to a trading relationship**.",
      "example_ids": [],
      "key_terms": [
        {
          "term": "Transaction costs",
          "meaning": "Costs of acquiring an input over and above the amount paid to the input supplier",
          "source_ref": "be--session-10#6"
        }
      ],
      "exam_line": "Transaction costs = search + negotiation + other required investments, over and above the price paid.",
      "clarification": null,
      "check_questions": [
