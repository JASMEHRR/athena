    {
      "id": "be-s9-exponential-smoothing-c2",
      "heading": "The smoothing formula",
      "explanation_md": "**F(t+1) = αY(t) + (1 - α)F(t)**\n\n- F(t+1): forecast for next period\n- Y(t): actual value this period\n- F(t): forecast for this period\n- **α: the smoothing constant, with 0 < α < 1**\n\nEach new forecast blends this period's actual value with this period's forecast. A **bigger α** reacts faster to the latest data.",
      "example_ids": [],
      "key_terms": [
        {
          "term": "Smoothing constant",
          "meaning": "α in F(t+1) = αY(t) + (1 - α)F(t), between 0 and 1",
          "source_ref": "be--session-9#27"
        }
      ],
      "exam_line": "F(t+1) = αY(t) + (1 - α)F(t), with 0 < α < 1.",
      "clarification": null,
      "check_questions": [
        {
          "id": "be-s9-exponential-smoothing-q-c8e40e34",
          "type": "mcq",
          "stem": "In exponential smoothing, the forecast for next period is:",
