    {
      "id": "be-s9-exponential-smoothing-c1",
      "heading": "Why exponential smoothing",
      "explanation_md": "A moving average gives **equal importance** to every observation inside its window. But the latest year usually says more about next year than an older one: 2025 sales tell you more about 2026 than 2023 sales do.\n\n**Exponential smoothing** gives **more importance to recent observations** and **progressively less** to older ones.",
      "example_ids": [],
      "key_terms": [],
      "exam_line": "Moving averages weight the window equally; exponential smoothing weights recent data more.",
      "clarification": null,
      "check_questions": [
        {
          "id": "be-s9-exponential-smoothing-q-854ad781",
          "type": "mcq",
          "stem": "The limitation of a moving average that exponential smoothing fixes is that it:",
          "options": [
            "Gives equal importance to all observations in the window",
            "Cannot be calculated by hand",
            "Needs a smoothing constant above 1"
          ],
          "answer": "Gives equal importance to all observations in the window",
          "accept": [],
          "explanation": "",
          "model_answer_md": "",
