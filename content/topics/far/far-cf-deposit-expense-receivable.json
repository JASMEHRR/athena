  "chunks": [
    {
      "id": "far-cf-deposit-expense-receivable-c1",
      "heading": "Transaction 4: a deposit is a liability",
      "explanation_md": "Circle Films **receives a ₹2,000 deposit** from a customer to film her parents' fiftieth wedding anniversary.\n\nCash is received, so assets increase. But it **has not yet provided the service, so it has an obligation to the customer.** Liabilities increase by the cash received, in an account called **Unearned Revenue**.\n\nTable: Cash ₹6,500 + ₹2,000 = ₹8,500; Unearned Revenue ₹0 + ₹2,000. Total assets ₹18,500 = Liabilities ₹2,000 + Equity ₹16,500.",
      "example_ids": [
        "far-ex-t4-deposit"
      ],
      "key_terms": [
        {
          "term": "Unearned revenue",
          "meaning": "The liability account that rises when cash is received before the service is provided.",
          "source_ref": "far--practice-circle-films-transaction-analysis#2"
        }
      ],
      "exam_line": "Cash received before the service is performed raises assets and liabilities (unearned revenue), not equity.",
      "clarification": null,
      "check_questions": [
        {
          "id": "far-cf-deposit-expense-receivable-q-4da90a04",
          "type": "mcq",
          "stem": "Why does a ₹2,000 deposit increase liabilities and not equity?",
