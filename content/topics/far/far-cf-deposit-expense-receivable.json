    {
      "id": "far-cf-deposit-expense-receivable-q-7d40c19d",
      "type": "short",
      "stem": "Differentiate between transaction 4 (deposit received) and transaction 6 (invoice left with the customer).",
      "options": [],
      "answer": "",
      "accept": [],
      "explanation": "",
      "model_answer_md": "**Transaction 4:** cash is received first and the service is still to be done. Cash rises by ₹2,000 and **liabilities rise** (unearned revenue). Equity does not change.\n\n**Transaction 6:** the service is done first and cash is still to come. Accounts receivable rises by ₹3,500 and **equity rises** (retained earnings). Liabilities do not change.\n\nIn one the company owes the customer; in the other the customer owes the company.",
      "rubric": [
        {
          "point": "Transaction 4: cash first, liability rises",
          "source_ref": "far--practice-circle-films-transaction-analysis#2"
        },
        {
          "point": "Transaction 6: service first, receivable rises",
          "source_ref": "far--practice-circle-films-transaction-analysis#2"
        },
        {
          "point": "Equity effect differs",
          "source_ref": "far--practice-circle-films-transaction-analysis#2"
        },
        {
          "point": "Who owes whom",
          "source_ref": "far--practice-circle-films-transaction-analysis#2"
        }
      ],
      "marks": 4.0,
