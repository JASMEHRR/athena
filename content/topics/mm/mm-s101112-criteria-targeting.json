    {
      "id": "mm-s101112-criteria-targeting-q-a0a7faba",
      "type": "long",
      "stem": "Explain how a firm moves from segmentation to targeting, including the criteria for effective segments.",
      "options": [],
      "answer": "",
      "accept": [],
      "explanation": "",
      "model_answer_md": "**Segmentation** divides a market into groups of customers with similar needs using demographic, geographic, behavioral and psychographic bases. For segments to be effective they should be measurable or identifiable, substantial, accessible, differentiable and actionable.\n\n**Targeting** then evaluates the attractiveness of each segment, selects one or more segments based on attractiveness, size and capability to serve, and designs marketing programmes accordingly. Mass marketing and customized marketing are contrasted.\n\n**Conclusion.** Segmentation creates the choices and targeting picks among them.",
      "rubric": [
        {
          "point": "Segmentation bases named",
          "source_ref": "mm--session-10-11-12mm#3"
        },
        {
          "point": "Five effective criteria",
          "source_ref": "mm--session-10-11-12mm#15"
        },
        {
          "point": "Evaluate and select segments",
          "source_ref": "mm--session-10-11-12mm#16"
        },
        {
          "point": "Basis of selection",
          "source_ref": "mm--session-10-11-12mm#16"
        }
