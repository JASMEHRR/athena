      "n": 4,
      "kind": "content",
      "title": "The Utility",
      "text": "The Utility\n4\nUtility is the WANT-SATISFYING PROPERTY of a COMMODITY from a COMMODITY ANGLE\nUtility is the psychological feeling of satisfaction, pleasure, happiness or well-being which a consumer derives from the consumption, possession or the use of a commodity from a consumer angle\nUtility is ‘subjective’ or ‘relative’ in nature",
      "bullets": [
        {
          "level": 1,
          "text": "4"
        },
        {
          "level": 0,
          "text": "Utility is the WANT-SATISFYING PROPERTY of a COMMODITY from a COMMODITY ANGLE"
        },
        {
          "level": 0,
          "text": "Utility is the psychological feeling of satisfaction, pleasure, happiness or well-being which a consumer derives from the consumption, possession or the use of a commodity from a consumer angle"
        },
        {
          "level": 0,
          "text": "Utility is ‘subjective’ or ‘relative’ in nature"
        }
      ],
